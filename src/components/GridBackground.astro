---
---

<div class="fixed inset-0 pointer-events-none overflow-hidden z-0" aria-hidden="true">
  <!-- Moving grid -->
  <div class="absolute inset-0 grid-bg opacity-60"></div>

  <!-- Underground gradient layers (intensifies as you scroll down) -->
  <div class="absolute inset-0 underground-layer" style="opacity: calc(0.35 + var(--depth-progress, 0) * 0.65);"></div>

  <!-- Horizontal scan lines -->
  <div class="absolute inset-0 opacity-[0.03]"
    style="background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(64,255,208,0.5) 2px, rgba(64,255,208,0.5) 4px);">
  </div>

  <!-- Radial glow center (drifts with scroll depth) -->
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] rounded-full
              bg-signal-cyan/[0.03] blur-[120px]"
    style="--tw-translate-y: calc(-50% + var(--depth-progress, 0) * 140px);"></div>
  <div class="absolute bottom-0 left-1/4 w-[600px] h-[400px] rounded-full
              bg-accent-orange/[0.04] blur-[100px]"
    style="transform: translateY(calc(var(--depth-progress, 0) * -70px));"></div>
</div>

<!-- Depth ruler -->
<div class="hidden lg:flex fixed top-1/2 start-4 xl:start-6 -translate-y-1/2 z-40 flex-col items-center pointer-events-none" aria-hidden="true">
  <span id="depth-value" class="text-[10px] font-mono text-signal-cyan/70 tracking-widest mb-3">0 m</span>
  <div id="depth-track" class="relative w-px h-[60vh] max-h-[560px] min-h-[320px] bg-gradient-to-b from-signal-cyan/40 via-white/10 to-accent-orange/40">
    <div class="absolute start-0 w-2 h-px bg-white/20" style="top: 0%"></div>
    <div class="absolute start-0 w-2 h-px bg-white/20" style="top: 25%"></div>
    <div class="absolute start-0 w-2 h-px bg-white/20" style="top: 50%"></div>
    <div class="absolute start-0 w-2 h-px bg-white/20" style="top: 75%"></div>
    <div class="absolute start-0 w-2 h-px bg-white/20" style="top: 100%"></div>
    <div id="depth-dot" class="absolute -start-[3px] top-0 w-2 h-2 rounded-full bg-signal-cyan shadow-[0_0_10px_rgba(64,255,208,0.8)]"></div>
  </div>
</div>

<script>
  function updateDepth() {
    const doc = document.documentElement;
    const scrollable = doc.scrollHeight - window.innerHeight;
    const progress = scrollable > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollable)) : 0;
    doc.style.setProperty('--depth-progress', progress.toString());

    const label = document.getElementById('depth-value');
    if (label) label.textContent = Math.round(progress * 20) + ' m';

    const track = document.getElementById('depth-track');
    const dot = document.getElementById('depth-dot');
    if (track && dot) {
      dot.style.transform = `translateY(${progress * track.clientHeight}px)`;
    }
  }

  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(() => {
        updateDepth();
        ticking = false;
      });
    }
  }, { passive: true });

  window.addEventListener('resize', updateDepth);
  updateDepth();
</script>
