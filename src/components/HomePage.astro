---
import type { Translations } from '../i18n/types';
import BaseLayout from '../layouts/BaseLayout.astro';
import GridBackground from '../components/GridBackground.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProductSection from '../components/ProductSection.astro';
import WorkflowSection from '../components/WorkflowSection.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
---

<BaseLayout
  lang={t.lang}
  dir={t.dir}
  locale={t.locale}
  title={t.meta.title}
  description={t.meta.description}
  keywords={t.meta.keywords}
>
  <GridBackground />
  <Header t={t} />

  <main class="relative z-10">
    <!-- Hero -->
    <section class="flex items-center pt-28 sm:pt-24 pb-4 sm:pb-6">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="grid lg:grid-cols-2 gap-10 lg:gap-12 items-center">
          <!-- Text -->
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full
                        bg-signal-cyan/10 border border-signal-cyan/20 mb-4 sm:mb-6">
              <span class="w-2 h-2 rounded-full bg-signal-cyan animate-pulse"></span>
              <span class="text-[10px] sm:text-xs font-mono text-signal-cyan tracking-wider">{t.hero.badge}</span>
            </div>

            <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold leading-tight mb-4 sm:mb-6">
              {t.hero.title1}
              <br />
              <span class="text-gradient neon-text">{t.hero.title2}</span>
              <br />
              {t.hero.title3}
            </h1>

            <p class="text-base sm:text-lg text-white/50 mb-6 sm:mb-8 max-w-lg leading-relaxed">
              {t.hero.description}
            </p>

            <div class="flex flex-col sm:flex-row flex-wrap gap-3 sm:gap-4">
              <a href="/satin-al" class="btn-primary w-full sm:w-auto justify-center">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m-10 0a2 2 0 100 4 2 2 0 000-4zm10 0a2 2 0 100 4 2 2 0 000-4z"/>
                </svg>
                {t.hero.ctaDemo}
              </a>
              <a href="/ozellikler" class="btn-secondary w-full sm:w-auto justify-center">
                {t.hero.ctaExplore}
              </a>
            </div>

            <div class="mt-8 sm:mt-10 flex flex-wrap items-center gap-4 sm:gap-6 text-xs sm:text-sm text-white/50">
              <div class="flex items-center gap-2">
                <span class="text-signal-cyan font-mono font-bold">2</span> {t.hero.statPlatform}
              </div>
              <div class="w-px h-4 bg-white/10 hidden sm:block"></div>
              <div class="flex items-center gap-2">
                <span class="text-signal-cyan font-mono font-bold">2</span> {t.hero.statFormats}
              </div>
              <div class="w-px h-4 bg-white/10 hidden sm:block"></div>
              <div class="flex items-center gap-2">
                <span class="text-signal-cyan font-mono font-bold">70+</span> {t.hero.statFilters}
              </div>
            </div>

            <div class="mt-6 sm:mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-white/45">
              <span class="inline-flex items-center gap-1.5">
                <svg class="w-4 h-4 text-signal-cyan shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
                {t.hero.trustDelivery}
              </span>
              <span class="inline-flex items-center gap-1.5">
                <svg class="w-4 h-4 text-signal-cyan shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
                {t.hero.trustSecurePayment}
              </span>
              <span class="inline-flex items-center gap-1.5">
                <svg class="w-4 h-4 text-signal-cyan shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M5.636 5.636l3.536 3.536m0 5.656l-3.536 3.536M12 12m-3 0a3 3 0 106 0 3 3 0 10-6 0"/>
                </svg>
                {t.hero.trustSupport}
              </span>
            </div>
          </div>

          <!-- Device mockup -->
          <div class="relative hidden sm:block">
            <div class="absolute inset-0 bg-signal-cyan/10 blur-[100px] rounded-full"></div>
            <div class="relative glass-panel neon-border p-1.5 sm:p-2 rounded-xl">
              <div class="flex items-center gap-1.5 px-2.5 py-2">
                <span class="w-2.5 h-2.5 rounded-full bg-white/20"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-white/20"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-white/20"></span>
              </div>
              <div class="aspect-[16/10] rounded-lg bg-ground-work overflow-hidden">
                <img
                  src={t.desktop.screenshot}
                  alt={t.desktop.screenshotAlt}
                  loading="eager"
                  class="w-full h-full object-cover object-top"
                />
              </div>
            </div>
            <div class="absolute -bottom-6 -right-4 sm:-right-8 w-24 sm:w-32
                        glass-panel neon-border p-1 rounded-2xl shadow-2xl">
              <div class="aspect-[9/16] rounded-xl bg-ground-work overflow-hidden">
                <img
                  src={t.android.screenshot}
                  alt={t.android.screenshotAlt}
                  loading="eager"
                  class="w-full h-full object-cover object-top"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Pricing -->
    <section id="fiyatlandirma" class="py-16 sm:py-24 border-t border-white/5">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-10 sm:mb-16">
          <span class="text-xs font-mono text-signal-cyan tracking-widest">{t.pricing.section}</span>
          <h2 class="section-title mt-2">{t.pricing.title}</h2>
          <p class="text-white/50 mt-4 max-w-2xl mx-auto text-sm sm:text-base px-2">
            {t.pricing.subtitle}
          </p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
          {t.pricing.items.map(item => (
            <div class="glass-panel p-5 sm:p-6 flex flex-col hover:border-signal-cyan/20 transition-colors relative">
              {item.comingSoon && (
                <span class="absolute top-4 right-4 sm:right-5 text-[10px] font-mono tracking-widest text-accent-orange bg-accent-orange/10 border border-accent-orange/30 rounded-full px-2.5 py-1">
                  {t.pricing.comingSoon}
                </span>
              )}
              {item.promoLabel && !item.comingSoon && (
                <span class="absolute top-4 right-4 sm:right-5 text-[10px] font-mono tracking-widest text-signal-cyan bg-signal-cyan/10 border border-signal-cyan/30 rounded-full px-2.5 py-1">
                  {item.promoLabel}
                </span>
              )}
              <h3 class="text-base sm:text-lg font-bold text-white mb-2 pr-24">{item.name}</h3>
              <p class="text-sm text-white/50 mb-1 flex-1">{item.description}</p>
              {item.compatNote && (
                <p class="text-[11px] text-white/35 mb-4">{item.compatNote}</p>
              )}
              <div class="flex items-end justify-between gap-3 mb-4">
                <span class="text-2xl sm:text-3xl font-extrabold text-gradient neon-text">{item.price}</span>
                <span class="text-[10px] text-white/40 font-mono mb-1">{t.pricing.priceNote}</span>
              </div>
              {item.comingSoon ? (
                <span class="btn-primary justify-center text-sm opacity-40 cursor-not-allowed pointer-events-none select-none">
                  {t.pricing.comingSoon}
                </span>
              ) : (
                <a href={`/satin-al?sku=${item.sku}`} class="btn-primary justify-center text-sm">
                  {t.pricing.cta}
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Desktop -->
    <ProductSection
      id="masaustu"
      badge={t.desktop.badge}
      title={t.desktop.title}
      subtitle={t.desktop.subtitle}
      features={t.desktop.features}
      screenshot={t.desktop.screenshot}
      screenshotAlt={t.desktop.screenshotAlt}
      accentColor="cyan"
      dir={t.dir}
    />

    <!-- Android -->
    <ProductSection
      id="android"
      badge={t.android.badge}
      title={t.android.title}
      subtitle={t.android.subtitle}
      features={t.android.features}
      screenshot={t.android.screenshot}
      screenshotAlt={t.android.screenshotAlt}
      accentColor="orange"
      reversed={true}
      mobile={true}
      dir={t.dir}
    />

    <!-- Field workflow -->
    <WorkflowSection t={t} />

    <!-- Trust -->
    <section class="py-10 sm:py-14 border-t border-white/5">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-6 sm:mb-8">
          {t.trust.items.map(item => (
            <div class="glass-panel p-4 sm:p-5 flex items-center gap-3">
              <span class="text-xl sm:text-2xl leading-none">{item.icon}</span>
              <div>
                <h3 class="text-sm font-semibold text-white/90 mb-0.5">{item.title}</h3>
                {item.description && (
                  <p class="text-xs text-white/50 leading-relaxed">{item.description}</p>
                )}
              </div>
            </div>
          ))}
        </div>
        <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-white/45">
          {t.trust.security.map(item => (
            <span class="inline-flex items-center gap-1.5">
              <span>{item.icon}</span>
              {item.text}
            </span>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer t={t} />
  <WhatsAppButton message={t.contact.waMessage} />
</BaseLayout>
